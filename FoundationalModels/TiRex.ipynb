   "source": [
    "import torch\n",
    "from tirex import load_model\n",
    "\n",
    "model = load_model(\"NX-AI/TiRex\")\n",
    "\n",
    "data = torch.rand((5,128))\n",
    "quantiles, mean = model.forecast(context=data, prediction_length=64)\n",
    "\n",
    "print(quantiles.shape)\n",
    "print(mean.shape)"
   ]
  }
 ],
